# Port on which the backend server will run
PORT=8989

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hacker_network

# Secret key used for signing JSON Web Tokens (JWT)
JWT_KEY=your_jwt_secret_key_here

# Google Maps API Key for geocoding services (getting coordinates from addresses)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend Client URL (for CORS)
FRONTEND_URL= "frontend deployed link"
